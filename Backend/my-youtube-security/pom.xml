<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>cn.diaojiahong</groupId>
		<artifactId>my-youtube-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>my-youtube-security</artifactId>
	<name>my-youtube-security</name>
	<description>JWT 鉴权公共件: 签发/验签, 网关与业务服务共享</description>

	<dependencies>
		<!-- 网关是 WebFlux 栈, 本模块必须保持零 servlet 依赖 -->
		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-jwt</artifactId>
			<version>5.8.43</version>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>
		<!--通用责任链步骤签名是响应式的(网关 WebFlux 是首个使用方), 版本由 spring-boot parent 托管-->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-core</artifactId>
		</dependency>
	</dependencies>
</project>
