<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>cn.diaojiahong</groupId>
		<artifactId>my-youtube-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>my-youtube-app</artifactId>
	<name>my-youtube-app</name>
	<description>启动器: 组装全部业务模块</description>

	<dependencies>
		<dependency>
			<groupId>cn.diaojiahong</groupId>
			<artifactId>my-youtube-common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>cn.diaojiahong</groupId>
			<artifactId>my-youtube-user</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>cn.diaojiahong</groupId>
			<artifactId>my-youtube-video</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>cn.diaojiahong</groupId>
			<artifactId>my-youtube-chat</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>cn.diaojiahong</groupId>
			<artifactId>my-youtube-search</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
