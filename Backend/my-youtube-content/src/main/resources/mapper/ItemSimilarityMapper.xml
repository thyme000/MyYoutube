<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.diaojiahong.myyoutube.recommend.mapper.ItemSimilarityMapper">

    <insert id="batchInsert">
        INSERT INTO item_similarity (algorithm, content_type, item_a, item_b, score) VALUES
        <foreach collection="list" item="it" separator=",">
            (#{it.algorithm}, #{it.contentType}, #{it.itemA}, #{it.itemB}, #{it.score})
        </foreach>
    </insert>

    <delete id="deleteByAlgorithm">
        DELETE FROM item_similarity WHERE algorithm = #{algorithm}
    </delete>
</mapper>
