# 跨编辑器的缩进/换行基线。ESLint 只管 JS/Vue 语义，格式一致性由这里兜底。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{xml,yml,yaml,properties,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
