# 复制为同目录 .env；以下两个 Paddle 推理模型目录必填。
# 目录必须包含 inference.yml、inference.pdiparams 和 inference.json/pdmodel。
OCR_DETECTION_MODEL_DIR=
OCR_RECOGNITION_MODEL_DIR=
OCR_RECOGNITION_BATCH_SIZE=2

# 启用的可选模块也必须填写模型目录；关闭时不需要目录。
OCR_USE_TEXTLINE_ORIENTATION=true
OCR_TEXTLINE_ORIENTATION_MODEL_DIR=
OCR_USE_DOC_ORIENTATION=false
OCR_DOC_ORIENTATION_MODEL_DIR=
OCR_USE_DOC_UNWARPING=false
OCR_DOC_UNWARPING_MODEL_DIR=

# 可选：服务端口默认 8088。
SERVER_PORT=8088

# 可选：并发、队列与 OCR 执行超时；当前值均为代码默认值。
OCR_CONCURRENCY=1
OCR_QUEUE_SIZE=4
OCR_QUEUE_TIMEOUT=60
OCR_EXECUTION_TIMEOUT=120
OCR_RECOVERY_ATTEMPTS=3
OCR_RECOVERY_BACKOFF=1
OCR_RECOVERY_MAX_DELAY=30

# 可选：Nacos 注册默认开启；不使用 Nacos 时改为 NACOS_ENABLED=false。
# 注册开启时，按实际可达地址调整 Nacos 和本机实例地址。
NACOS_ENABLED=true
NACOS_ADDR=127.0.0.1:8848
NACOS_INSTANCE_IP=127.0.0.1
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER=DEFAULT
NACOS_CHECK_INTERVAL=15
NACOS_OPERATION_TIMEOUT=10
NACOS_RECONNECT_MAX_DELAY=60
# 可选：Nacos 开启鉴权时设置，勿把真实凭据写进此示例。
# NACOS_USERNAME=
# NACOS_PASSWORD=

# 可选：日志路径相对于本服务目录；Filebeat 需挂载或采集相同目录。
MODEL_LOG_DIRECTORY=logs

# 可选：单张图片下载和解码上限；当前值均为代码默认值。
OCR_MAX_IMAGE_BYTES=33554432
OCR_MAX_IMAGE_PIXELS=40000000
OCR_MAX_IMAGE_EDGE=16000

# 可选：追踪默认关闭。启动 SkyWalking OAP 后再启用；start.sh 会加载项目内的 Python Agent。
# PIPELINE_TRACING_ENABLED=true
# SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
# MODEL_TRACE_SAMPLE_PER_3_SECS=10
