# 本文件按进程分段展示配置；只复制对应进程的一段，不要整份加载。
# Java 段设为对应 JVM 的环境变量；Python 段必须写入各服务目录的 .env，终端 export 不生效。
# 保留服务原有的 Spring Profile，在原值后追加 json-logging 等 Profile。
# 以下 OAP 地址适用于在这台宿主机运行的进程；跨机器部署时改为可达的 OAP 地址。
# Java 追踪还需在每个 JVM 的启动参数中加入：-javaagent:/绝对路径/skywalking-agent/skywalking-agent.jar
# 只设置 SW_AGENT_COLLECTOR_BACKEND_SERVICES 不会自动安装 Agent。

# --------- Gateway：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-gateway
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10

# --------- user：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-user-service
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10

# --------- chat：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-chat-service
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10

# --------- search：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-search-service
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10

# --------- admin：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-admin-service
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10

# --------- llm：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-llm-service
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10

# --------- video：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging,monitoring
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
PIPELINE_MONITORING_ENABLED=true
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-video-service
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10
# video_db 完成事件表结构准备后，才将上方 Profile 改为下行并启用三个开关。
# SPRING_PROFILES_ACTIVE=local,json-logging,monitoring,observability
# PIPELINE_EVENT_RECORDING_ENABLED=true
# PIPELINE_EVENT_DELIVERY_ENABLED=true
# PIPELINE_EVENT_CLEANUP_ENABLED=true

# --------- transcode：Java 进程 ---------
SPRING_PROFILES_ACTIVE=local,json-logging,monitoring
OBSERVABILITY_ACTUATOR_ENDPOINTS=health,prometheus
PIPELINE_MONITORING_ENABLED=true
OBSERVABILITY_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/logs/observability
SW_AGENT_NAME=my-youtube-transcode-service
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
SW_AGENT_SAMPLE=10
# transcode_db 完成事件表结构准备后，才将上方 Profile 改为下行并启用三个开关。
# SPRING_PROFILES_ACTIVE=local,json-logging,monitoring,observability
# PIPELINE_EVENT_RECORDING_ENABLED=true
# PIPELINE_EVENT_DELIVERY_ENABLED=true
# PIPELINE_EVENT_CLEANUP_ENABLED=true

# --------- manage.py 启动的摄取 JVM ---------
# manage.py 已设置指标采样及 ES 默认地址；只在要追踪摄取 JVM 时增加这些设置。
# 这些变量设在运行 manage.py 的终端，不加到 video 或 transcode。
# INGEST_JAVA_OPTS="-Xms128m -Xmx256m -javaagent:/绝对路径/skywalking-agent/skywalking-agent.jar"
# SW_AGENT_NAME=my-youtube-observability
# SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
# SW_AGENT_SAMPLE=10
# INGEST_ELASTICSEARCH=http://127.0.0.1:19200

# --------- ASR：写入项目根/asr-svc/.env ---------
# 先按操作说明准备 Python Agent；保留 .env 内既有模型与 Nacos 配置，再添加以下项。
# 修改 .env 后须重启 Python 服务，复用现有实例不会重新加载。
MODEL_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/asr-svc/logs
PIPELINE_TRACING_ENABLED=true
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
MODEL_TRACE_SAMPLE_PER_3_SECS=10

# --------- OCR：写入项目根/ocr-svc/.env ---------
MODEL_LOG_DIRECTORY=/Users/thyme/project/java/MyYoutube/ocr-svc/logs
PIPELINE_TRACING_ENABLED=true
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
MODEL_TRACE_SAMPLE_PER_3_SECS=10
