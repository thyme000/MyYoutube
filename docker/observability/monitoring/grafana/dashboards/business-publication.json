      "targets": [
        {
          "refId": "A",
          "expr": "max (myyoutube_business_publication_capped{job=\"myyoutube-java\",instance=~\"$instance\"} and on(instance) (pipeline_metrics_sample_enabled{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} == 1) and on(instance) (pipeline_metrics_sample_success{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} == 1) and on(instance) (pipeline_metrics_sample_age_seconds{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} <= 90))",
          "legendFormat": ""
        }
