        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_metrics_sample_success{job=\"myyoutube-java\",instance=~\"$instance\"}",
          "legendFormat": "{{component}} · {{instance}}"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "各后台采样年龄",
      "type": "timeseries",
      "description": "",
