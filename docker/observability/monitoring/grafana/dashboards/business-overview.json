{
  "uid": "myyoutube-business-overview",
  "title": "MyYoutube 业务总览",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "MyYoutube",
    "业务"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "业务总览",
      "url": "/d/myyoutube-business-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "各链路看板",
      "type": "dashboards",
      "tags": [
        "业务"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "内容单笔事件",
      "url": "http://127.0.0.1:15601/app/dashboards#/view/myyoutube-business-flow",
      "targetBlank": true
    },
    {
      "title": "上传准备单笔事件",
      "url": "http://127.0.0.1:15601/app/dashboards#/view/myyoutube-upload-flow",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "myyoutube-prometheus"
        },
        "query": "label_values(up{job=\"myyoutube-java\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "口径与排障入口",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "[注册与登录](/d/myyoutube-business-identity) · [上传与准备](/d/myyoutube-business-upload) · [内容加工](/d/myyoutube-business-pipeline) · [审核与发布](/d/myyoutube-business-publication) · [搜索与推荐](/d/myyoutube-business-discovery) · [内容访问与播放记录](/d/myyoutube-business-consumption) · [点赞收藏评论与关注](/d/myyoutube-business-interaction) · [聊天与通知](/d/myyoutube-business-messaging) · [清理与补偿](/d/myyoutube-business-maintenance)\n\n统计单位为操作调用/尝试，包含重试和幂等重放，不是去重用户数、内容数或端到端成功率。无流量、未接入、采样失败或过期显示无数据，不补零。\n\nsuccess=正常返回；empty=返回空列表/空页；no_change=条件未命中；business_error=BizException（含业务校验，也可能包装基础设施故障）；failure=其他异常或事务回滚。"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      }
    },
    {
      "title": "业务操作完成速率（不是去重业务数）",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(chain,outcome) (rate(myyoutube_business_operations_total{job=\"myyoutube-java\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{chain}} · {{outcome}}"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "业务异常与系统异常次数",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(chain,outcome) (increase(myyoutube_business_operations_total{job=\"myyoutube-java\",instance=~\"$instance\",outcome=~\"business_error|failure\"}[$__rate_interval]))",
          "legendFormat": "{{chain}} · {{outcome}}"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "已接入的业务操作数",
      "type": "timeseries",
      "description": "后端启动时登记；有指标但调用量为零表示已接入且暂无调用，缺指标不能判断健康。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by(chain) (myyoutube_business_operation_enabled{job=\"myyoutube-java\",instance=~\"$instance\"})",
          "legendFormat": "{{chain}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "当前在途操作",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(chain) (myyoutube_business_inflight{job=\"myyoutube-java\",instance=~\"$instance\"})",
          "legendFormat": "{{chain}}"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "服务指标抓取状态",
      "type": "timeseries",
      "description": "1 可抓取，0 抓取失败；目标未配置时没有数据，不表示服务正常。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"myyoutube-java\",instance=~\"$instance\"}",
          "legendFormat": "{{service}} · {{instance}}"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "上传 / 准备 / 待提交 / 失败草稿（有界下限）",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(status) (myyoutube_business_drafts_lowerbound{job=\"myyoutube-java\",instance=~\"$instance\"} and on(instance) (pipeline_metrics_sample_enabled{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} == 1) and on(instance) (pipeline_metrics_sample_success{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} == 1) and on(instance) (pipeline_metrics_sample_age_seconds{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} <= 90))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "加工重试耗尽 / 阻塞存量",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(type,status) (media_tasks{job=\"myyoutube-java\",instance=~\"$instance\",status=~\"DEAD|BLOCKED\"} and on(instance) (pipeline_metrics_sample_enabled{job=\"myyoutube-java\",instance=~\"$instance\",component=\"tasks\"} == 1) and on(instance) (pipeline_metrics_sample_success{job=\"myyoutube-java\",instance=~\"$instance\",component=\"tasks\"} == 1) and on(instance) (pipeline_metrics_sample_age_seconds{job=\"myyoutube-java\",instance=~\"$instance\",component=\"tasks\"} <= 90))",
          "legendFormat": "{{type}} · {{status}}"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "待自动 / 人工审核",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(mode) (media_review_queue{job=\"myyoutube-java\",instance=~\"$instance\"} and on(instance) (pipeline_metrics_sample_enabled{job=\"myyoutube-java\",instance=~\"$instance\",component=\"review\"} == 1) and on(instance) (pipeline_metrics_sample_success{job=\"myyoutube-java\",instance=~\"$instance\",component=\"review\"} == 1) and on(instance) (pipeline_metrics_sample_age_seconds{job=\"myyoutube-java\",instance=~\"$instance\",component=\"review\"} <= 90))",
          "legendFormat": "{{mode}}"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "发布三个分支待完成（有界下限）",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(branch) (myyoutube_business_publication_pending_lowerbound{job=\"myyoutube-java\",instance=~\"$instance\"} and on(instance) (pipeline_metrics_sample_enabled{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} == 1) and on(instance) (pipeline_metrics_sample_success{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} == 1) and on(instance) (pipeline_metrics_sample_age_seconds{job=\"myyoutube-java\",instance=~\"$instance\",component=\"business_backlog\"} <= 90))",
          "legendFormat": "{{branch}}"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "各后台采样结果",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未观测 / 无样本"
        },
        "overrides": []
