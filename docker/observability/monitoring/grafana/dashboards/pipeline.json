{
  "uid": "myyoutube-pipeline",
  "title": "MyYoutube 内容管线",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "采样成功状态（0 为失败）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_metrics_sample_success",
          "legendFormat": "{{service}} {{component}} {{group}} {{status}} {{type}} {{kind}} {{reason}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "距上次成功采样",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_metrics_sample_age_seconds",
          "legendFormat": "{{service}} {{component}} {{group}} {{status}} {{type}} {{kind}} {{reason}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Outbox 最老未发送年龄",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_outbox_oldest_seconds",
          "legendFormat": "{{service}} {{component}} {{group}} {{status}} {{type}} {{kind}} {{reason}} {{result}}"
