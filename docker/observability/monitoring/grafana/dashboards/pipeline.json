      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myyoutube-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(group) (mq_dlq_retained)",
          "legendFormat": "{{service}} {{component}} {{group}} {{status}} {{type}} {{kind}} {{reason}} {{result}}"
